# {{APP_NAME}} Environment Configuration
# Generated: {{TIMESTAMP}}

# Application
LC_ALL=en_US.UTF-8
PYTHONUNBUFFERED=1
C_FORCE_ROOT=False
DEFAULT_TIMEZONE=America/Toronto

# Process workers (read by hypercorn_config.py and the Procfile)
WEB_CONCURRENCY={{WEB_CONCURRENCY}}
CAPI_WORKERS={{CAPI_WORKERS}}
PAPI_WORKERS={{PAPI_WORKERS}}

SECRET_KEY={{SECRET_KEY}}
AUTH_SERVER_SHARED_SECRET={{AUTH_SERVER_SHARED_SECRET}}
AUTHLIB_INSECURE_TRANSPORT={{AUTHLIB_INSECURE_TRANSPORT}}

# URLs (computed from DOMAIN — client build bakes these in!)
SUPERDESK_URL={{SUPERDESK_URL}}
CONTENTAPI_URL={{CONTENTAPI_URL}}
# PRODAPI_URL is the host only (no path / trailing slash); prod_api adds the prefix
PRODAPI_URL={{PRODAPI_URL}}
SUPERDESK_WS_URL={{SUPERDESK_WS_URL}}
SUPERDESK_CLIENT_URL={{CLIENT_URL}}

# MongoDB (5 databases)
# For an external cluster (e.g. Atlas) set MONGO_URI etc. in the deploy env
# file to mongodb+srv://user:pass@cluster.xxxx.mongodb.net/<db>?retryWrites=true&w=majority
# Values are quoted: Atlas query strings contain '&', which bash `source` would
# otherwise treat as a job-control operator.
MONGO_URI="{{MONGO_URI}}"
LEGAL_ARCHIVE_URI="{{LEGAL_ARCHIVE_URI}}"
ARCHIVED_URI="{{ARCHIVED_URI}}"
PUBLICAPI_MONGO_URI="{{PUBLICAPI_MONGO_URI}}"
CONTENTAPI_MONGO_URI="{{CONTENTAPI_MONGO_URI}}"

# Elasticsearch
ELASTICSEARCH_URL={{ELASTICSEARCH_URL}}
ELASTICSEARCH_INDEX={{ELASTICSEARCH_INDEX}}
CONTENTAPI_ELASTICSEARCH_INDEX={{CONTENTAPI_ES_INDEX}}
CONTENTAPI_ELASTIC_INDEX={{CONTENTAPI_ES_INDEX}}

# Redis / Celery
REDIS_URL={{REDIS_URL}}
CELERY_BROKER_URL={{REDIS_URL}}
SUPERDESK_CELERY_PREFIX=

# Semaphore (Progress/Smartlogic)
SEMAPHORE_BASE_URL={{SEMAPHORE_BASE_URL}}
SEMAPHORE_TOKEN_URL={{SEMAPHORE_TOKEN_URL}}
SEMAPHORE_API_KEY_URL={{SEMAPHORE_API_KEY_URL}}
SEMAPHORE_ANALYZE_URL={{SEMAPHORE_ANALYZE_URL}}
SEMAPHORE_SEARCH_URL={{SEMAPHORE_SEARCH_URL}}
SEMAPHORE_GET_PARENT_URL={{SEMAPHORE_GET_PARENT_URL}}
SEMAPHORE_CREATE_TAG_URL={{SEMAPHORE_CREATE_TAG_URL}}
SEMAPHORE_CREATE_TAG_TASK={{SEMAPHORE_CREATE_TAG_TASK}}
SEMAPHORE_CREATE_TAG_QUERY={{SEMAPHORE_CREATE_TAG_QUERY}}

# Translation services
GOOGLE_API_KEY={{GOOGLE_API_KEY}}
GOOGLE_API_URL={{GOOGLE_API_URL}}
GOOGLE_PROJECT_ID={{GOOGLE_PROJECT_ID}}
GOOGLE_PROJECT_LOCATION={{GOOGLE_PROJECT_LOCATION}}
GOOGLE_APPLICATION_CREDENTIALS={{GOOGLE_APPLICATION_CREDENTIALS}}
GOOGLE_SERVICE_ACCOUNT_PATH={{GOOGLE_SERVICE_ACCOUNT_PATH}}
DEEPL_AUTH_KEY={{DEEPL_AUTH_KEY}}
DEEPL_API_URL={{DEEPL_API_URL}}

# Archive search (cp.archive_search) — uncomment and configure to enable
# (quote ARCHIVE_SEARCH_MONGO_URI if it is an Atlas mongodb+srv:// string)
# ARCHIVE_SEARCH_MONGO_URI=
# ARCHIVE_SEARCH_MONGO_CLUSTER=
# ARCHIVE_SEARCH_MONGO_COLLECTION=
# ARCHIVE_SEARCH_API_BASE_URL=http://localhost:8080
# ARCHIVE_SEARCH_API_KEY=

# S3 / Media (uncomment and configure if using S3)
# AMAZON_CONTAINER_NAME=
# AMAZON_S3_SUBFOLDER=superdesk
# MEDIA_PREFIX=
# AMAZON_SERVE_DIRECT_LINKS=True
# AMAZON_S3_USE_HTTPS=True

{{OPTIONAL_VARS}}
