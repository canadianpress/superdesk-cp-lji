# {{APP_NAME}} nginx configuration
# Domain: {{DOMAIN}}
# Generated: {{TIMESTAMP}}

server {
    listen 80 default_server;
    server_name {{DOMAIN}};

    client_max_body_size 1024m;
    server_tokens off;

    # Gzip compression
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 1;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css application/json application/x-javascript
               application/javascript text/xml application/xml application/xml+rss
               text/javascript;

    # Proxy buffer defaults
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Accept-Encoding "";
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    client_body_buffer_size 128k;

    # Proxy timeouts
    proxy_connect_timeout 300;
    proxy_send_timeout 300;
    proxy_read_timeout 300;

    # Logging
    access_log {{LOG_DIR}}/nginx_access.log;
    error_log {{LOG_DIR}}/nginx_error.log;

    # WebSocket
    location /ws {
        proxy_pass http://127.0.0.1:{{WS_PORT}}/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # REST API
    location /api {
        proxy_pass http://127.0.0.1:{{WEB_PORT}};
        proxy_set_header Host $host;
        expires epoch;

        sub_filter_once off;
        sub_filter_types application/json;
        sub_filter 'http://localhost' 'http://$host';
    }

    # Content API
    location /contentapi {
        proxy_pass http://127.0.0.1:{{CAPI_PORT}};
        proxy_set_header Host $host;
        expires epoch;
    }

    # Production API (prod_api / papi)
    location /prodapi {
        proxy_pass http://127.0.0.1:{{PAPI_PORT}};
        proxy_set_header Host $host;
        expires epoch;
    }

    # Let's Encrypt / ACME
    location /.well-known {
        root /var/tmp;
    }

    # Static frontend
    location / {
        root {{CLIENT_DIR}}/dist;

        sub_filter_once off;
        sub_filter_types application/javascript;
        sub_filter 'http://localhost' 'http://$host';
        sub_filter 'ws://localhost/ws' 'ws://$host/ws';
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
